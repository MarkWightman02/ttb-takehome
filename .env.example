# Optional: copy this file to .env in the repository root.
# FastAPI reads the root .env; environment variables take precedence.
TTB_ENVIRONMENT=development
TTB_LOG_LEVEL=INFO
TTB_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional: serve a production frontend build through FastAPI.
# Use an absolute path to frontend/dist after running pnpm build.
# TTB_FRONTEND_DIST=C:/path/to/TTB/frontend/dist

# Vite development proxy; Docker Compose sets this to http://backend:8000.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
